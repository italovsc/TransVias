@model TransVias.ViewModels.EnderecoViewModel

@{
    ViewData["Title"] = "Endereço";
    Layout = "_MotoristaLayout";
}

<section class="registration-page">

    <div class="container">

        <div class="registration-card">

            <div class="registration-heading">
                <span class="registration-line"></span>

                <h1>Cadastro de motorista</h1>

                <p>Etapa 2 de 4 — Endereço</p>
            </div>


            <!-- PROGRESSO -->
            <div class="registration-progress">

                <div class="progress-step completed">
                    <div class="step-circle">✓</div>
                    <span>Dados pessoais</span>
                </div>

                <div class="progress-line completed-line"></div>

                <div class="progress-step active">
                    <div class="step-circle">2</div>
                    <span>Endereço</span>
                </div>

                <div class="progress-line"></div>

                <div class="progress-step">
                    <div class="step-circle">3</div>
                    <span>Veículo</span>
                </div>

                <div class="progress-line"></div>

                <div class="progress-step">
                    <div class="step-circle">4</div>
                    <span>Revisão</span>
                </div>

            </div>


            <!-- FORMULÁRIO -->
            <form asp-controller="Motorista"
                  asp-action="Endereco"
                  method="post"
                  class="registration-form">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- CEP -->
                <div class="row">

                    <div class="col-md-5 mb-4">

                        <label asp-for="Cep"
                               class="form-label registration-label">
                            CEP <span>*</span>
                        </label>

                        <input asp-for="Cep"
                               class="form-control registration-input"
                               placeholder="00000-000" />

                        <span asp-validation-for="Cep"
                              class="text-danger validation-message">
                        </span>

                    </div>

                </div>


                <!-- Rua / Avenida -->
                <div class="mb-4">

                    <label asp-for="RuaAvenida"
                           class="form-label registration-label">
                        Rua / Avenida <span>*</span>
                    </label>

                    <input asp-for="RuaAvenida"
                           class="form-control registration-input"
                           placeholder="Digite o nome da rua ou avenida" />

                    <span asp-validation-for="RuaAvenida"
                          class="text-danger validation-message">
                    </span>

                </div>


                <div class="row">

                    <!-- Número -->
                    <div class="col-md-4 mb-4">

                        <label asp-for="Numero"
                               class="form-label registration-label">
                            Número <span>*</span>
                        </label>

                        <input asp-for="Numero"
                               class="form-control registration-input"
                               placeholder="Ex.: 120" />

                        <span asp-validation-for="Numero"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Complemento -->
                    <div class="col-md-8 mb-4">

                        <label asp-for="Complemento"
                               class="form-label registration-label">
                            Complemento
                        </label>

                        <input asp-for="Complemento"
                               class="form-control registration-input"
                               placeholder="Apartamento, bloco, referência..." />

                    </div>

                </div>


                <!-- Bairro -->
                <div class="mb-4">

                    <label asp-for="Bairro"
                           class="form-label registration-label">
                        Bairro <span>*</span>
                    </label>

                    <input asp-for="Bairro"
                           class="form-control registration-input"
                           placeholder="Digite o bairro" />

                    <span asp-validation-for="Bairro"
                          class="text-danger validation-message">
                    </span>

                </div>


                <div class="row">

                    <!-- Cidade -->
                    <div class="col-md-8 mb-4">

                        <label asp-for="Cidade"
                               class="form-label registration-label">
                            Cidade <span>*</span>
                        </label>

                        <input asp-for="Cidade"
                               class="form-control registration-input"
                               placeholder="Digite a cidade" />

                        <span asp-validation-for="Cidade"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Estado -->
                    <div class="col-md-4 mb-4">

                        <label asp-for="Estado"
                               class="form-label registration-label">
                            Estado <span>*</span>
                        </label>

                        <select asp-for="Estado"
                                class="form-select registration-input">

                            <option value="">Selecione</option>
                            <option value="AC">AC</option>
                            <option value="AL">AL</option>
                            <option value="AP">AP</option>
                            <option value="AM">AM</option>
                            <option value="BA">BA</option>
                            <option value="CE">CE</option>
                            <option value="DF">DF</option>
                            <option value="ES">ES</option>
                            <option value="GO">GO</option>
                            <option value="MA">MA</option>
                            <option value="MT">MT</option>
                            <option value="MS">MS</option>
                            <option value="MG">MG</option>
                            <option value="PA">PA</option>
                            <option value="PB">PB</option>
                            <option value="PR">PR</option>
                            <option value="PE">PE</option>
                            <option value="PI">PI</option>
                            <option value="RJ">RJ</option>
                            <option value="RN">RN</option>
                            <option value="RS">RS</option>
                            <option value="RO">RO</option>
                            <option value="RR">RR</option>
                            <option value="SC">SC</option>
                            <option value="SP">SP</option>
                            <option value="SE">SE</option>
                            <option value="TO">TO</option>

                        </select>

                        <span asp-validation-for="Estado"
                              class="text-danger validation-message">
                        </span>

                    </div>

                </div>


                <div class="registration-footer">

                    <a asp-controller="Motorista"
                       asp-action="DadosPessoais"
                       class="btn registration-back-button">

                        ← Voltar
                    </a>

                    <div class="d-flex align-items-center gap-4">

                        <span class="required-info">
                            * Campos obrigatórios
                        </span>

                        <button type="submit"
                                class="btn btn-primary registration-next-button">

                            Continuar →

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}