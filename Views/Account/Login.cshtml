@model TransVias.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
    Layout = "_PublicLayout";
}

<section class="auth-page">
    <div class="container">
        <div class="row auth-wrapper g-0">

            <!-- FORMULÁRIO -->
            <div class="col-lg-6">
                <div class="auth-form-container">

                    <div class="auth-heading">
                        <span class="auth-eyebrow">Acessar conta</span>

                        <h1>Entrar</h1>

                        <p>
                            Acesse sua conta para acompanhar o andamento
                            do seu cadastro como motorista parceiro.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label auth-label">
                                E-mail <span>*</span>
                            </label>

                            <input asp-for="Email"
                                   class="form-control auth-input"
                                   placeholder="seu@email.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger validation-message">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha"
                                   class="form-label auth-label">
                                Senha <span>*</span>
                            </label>

                            <input asp-for="Senha"
                                   type="password"
                                   class="form-control auth-input"
                                   placeholder="Digite sua senha"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Senha"
                                  class="text-danger validation-message">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary auth-submit-button">
                            Entrar
                        </button>

                    </form>

                    <div class="auth-divider">
                        <span>ou</span>
                    </div>

                    <div class="auth-footer-text">
                        <p>Ainda não possui uma conta?</p>

                        <a asp-controller="Account"
                           asp-action="Register">
                            Criar conta
                        </a>
                    </div>

                </div>
            </div>


            <!-- LADO VISUAL -->
            <div class="col-lg-6 d-none d-lg-block">

                <div class="auth-visual">

                    <div class="auth-visual-content">

                        <span class="auth-visual-eyebrow">
                            Seja um motorista parceiro
                        </span>

                        <h2>
                            Sua jornada
                            <span>começa aqui</span>
                        </h2>

                        <p class="auth-visual-description">
                            Entre na sua conta e acompanhe o andamento
                            do seu cadastro de forma simples e segura.
                        </p>

                        <div class="auth-benefits">

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">01</div>

                                <div>
                                    <strong>Acompanhe seu status</strong>

                                    <span>
                                        Consulte a situação do cadastro
                                        pelo seu painel.
                                    </span>
                                </div>
                            </div>

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">02</div>

                                <div>
                                    <strong>Acesso seguro</strong>

                                    <span>
                                        Entre utilizando seu e-mail
                                        e senha cadastrados.
                                    </span>
                                </div>
                            </div>

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">03</div>

                                <div>
                                    <strong>Mais praticidade</strong>

                                    <span>
                                        Consulte suas informações sempre
                                        que precisar.
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}