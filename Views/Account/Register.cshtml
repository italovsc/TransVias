@model TransVias.ViewModels.CriarContaViewModel

@{
    ViewData["Title"] = "Criar conta";
    Layout = "_PublicLayout";
}

<section class="auth-page">
    <div class="container">
        <div class="row auth-wrapper g-0">

            <!-- FORMULÁRIO -->
            <div class="col-lg-6">
                <div class="auth-form-container">

                    <div class="auth-heading">
                        <span class="auth-eyebrow">Criar conta</span>

                        <h1>Crie sua conta</h1>

                        <p>
                            Crie seu acesso para iniciar o cadastro
                            como motorista parceiro.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label auth-label">
                                E-mail <span>*</span>
                            </label>

                            <input asp-for="Email"
                                   class="form-control auth-input"
                                   placeholder="seu@email.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger validation-message">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Senha"
                                   class="form-label auth-label">
                                Senha <span>*</span>
                            </label>

                            <input asp-for="Senha"
                                   type="password"
                                   class="form-control auth-input"
                                   placeholder="Crie uma senha"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Senha"
                                  class="text-danger validation-message">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmarSenha"
                                   class="form-label auth-label">
                                Confirmar senha <span>*</span>
                            </label>

                            <input asp-for="ConfirmarSenha"
                                   type="password"
                                   class="form-control auth-input"
                                   placeholder="Confirme sua senha"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmarSenha"
                                  class="text-danger validation-message">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary auth-submit-button">
                            Criar conta e continuar
                        </button>

                    </form>

                    <div class="auth-divider">
                        <span>ou</span>
                    </div>

                    <div class="auth-footer-text">
                        <p>Já possui uma conta?</p>

                        <a asp-controller="Account"
                           asp-action="Login">
                            Entrar
                        </a>
                    </div>

                </div>
            </div>


            <!-- LADO VISUAL -->
            <div class="col-lg-6 d-none d-lg-block">

                <div class="auth-visual">

                    <div class="auth-visual-overlay"></div>

                    <div class="auth-visual-content">

                        <span class="auth-visual-eyebrow">
                            Seja um motorista parceiro
                        </span>

                        <h2>
                            Juntos vamos
                            <span>mais longe</span>
                        </h2>

                        <p class="auth-visual-description">
                            Faça parte da nossa rede e acompanhe
                            sua solicitação de forma simples e segura.
                        </p>

                        <div class="auth-benefits">

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">01</div>

                                <div>
                                    <strong>Processo simples</strong>
                                    <span>
                                        Cadastro rápido e sem burocracia.
                                    </span>
                                </div>
                            </div>

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">02</div>

                                <div>
                                    <strong>Dados protegidos</strong>
                                    <span>
                                        Sua senha é armazenada com segurança.
                                    </span>
                                </div>
                            </div>

                            <div class="auth-benefit">
                                <div class="auth-benefit-number">03</div>

                                <div>
                                    <strong>Acompanhamento online</strong>
                                    <span>
                                        Consulte o status do cadastro
                                        pelo seu painel.
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}